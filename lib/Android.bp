lineage_sdk_lib_src = "src/java/org/lineageos/lib/"

java_library {
    name: "org.lineageos.lib.phone",
    sdk_version: "current",
    static_libs: [
        "libphonenumber",
    ],

    srcs: [
        lineage_sdk_lib_src + "/phone/*.java",
        ":spn-info",
    ],
}

// Sensitive Phone Numbers schema
// =============================================================
filegroup {
    name: "spn-schema",
    srcs: ["SpnInfo.xsd"],
}

xsd_config {
    name: "spn-info",
    srcs: [":spn-schema"],
    api_dir: "schema",
    package_name: "org.lineageos.lib.phone.spn",
}
